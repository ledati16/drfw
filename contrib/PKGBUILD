# Maintainer: Your Name <your.email@example.com>
pkgname=drfw-git
pkgver=r336.76fd4fc
pkgrel=1
pkgdesc="A safe, transparent nftables firewall for Linux, with a GUI and CLI"
arch=('x86_64')
url="https://github.com/ledati16/drfw"
license=('MIT')
# The GUI loads libxkbcommon and the Wayland or X11 client libraries at run
# time (not linked, so namcap cannot see them). The root-side revert guard
# needs flock and setsid (util-linux) and uses systemd-run/systemctl when
# systemd is PID 1.
depends=(
    'nftables' 'gcc-libs' 'glibc' 'util-linux' 'systemd'
    'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr'
)
makedepends=('git' 'cargo')
# tests/mock_nft.sh validates JSON with jq; the kernel tests (unprivileged
# namespaces) need unshare/nsenter (util-linux), ip (iproute2) and ping (iputils)
checkdepends=('jq' 'iproute2' 'iputils')
optdepends=(
    'polkit: for pkexec elevation in GUI environments (the password is remembered for ~5 minutes)'
    'sudo: for sudo elevation in terminal environments'
    'vulkan-icd-loader: GPU rendering (with a Vulkan driver; software rendering otherwise)'
    'xdg-desktop-portal: file dialogs for exports'
)
provides=('drfw')
conflicts=('drfw')
source=("${pkgname%-git}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname%-git}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# Toolchain: do NOT export RUSTUP_TOOLCHAIN here. rust-toolchain.toml pins
# the exact Rust release (rust-version in Cargo.toml matches), and overriding
# it with "stable" fails whenever the installed stable is older than the pin.
# With rustup, the pinned toolchain is used (and installed if missing); with
# Arch's `rust` package, it must be at least the pinned version.

prepare() {
    cd "${pkgname%-git}"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

# Compile-time configuration (see "Packaging" in README.md). Arch keeps nft in
# /usr/bin, the config in /etc/nftables.conf and loads it with
# nftables.service. Naming nft explicitly lets the no-prompt check and the
# elevated scripts use it without searching PATH.
_drfw_env() {
    # Same target dir for build, check and package (a CARGO_TARGET_DIR from
    # the environment would otherwise put the binary elsewhere)
    export CARGO_TARGET_DIR=target
    export DRFW_SYSTEM_NFT_PATH=/etc/nftables.conf
    export DRFW_SYSTEM_NFT_SERVICE=nftables.service
    export DRFW_NFT_PATH=/usr/bin/nft
    export DRFW_HELPER_PATH=/usr/lib/drfw/drfw-helper
}

build() {
    cd "${pkgname%-git}"
    _drfw_env
    cargo build --frozen --release
}

check() {
    cd "${pkgname%-git}"
    # Debug build on purpose: overflow checks and debug_assert!() are active.
    # Runs as the build user, no root needed. Most tests use the mock nft
    # (tests/mock_nft.sh, set up by the tests themselves). tests/real_nft.rs
    # uses the real nft inside an unprivileged user + network namespace
    # (`unshare -rn`), never the host firewall, and skips itself where such
    # namespaces are unavailable (e.g. some clean chroots). Do not set
    # DRFW_REQUIRE_REAL_NFT here: it turns those skips into failures.
    _drfw_env
    cargo test --frozen
}

package() {
    cd "${pkgname%-git}"
    install -Dm755 target/release/drfw "$pkgdir/usr/bin/drfw"
    # The root helper: the only program DRFW elevates (DRFW_HELPER_PATH above)
    install -Dm755 target/release/drfw-helper "$pkgdir/usr/lib/drfw/drfw-helper"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 contrib/drfw.desktop "$pkgdir/usr/share/applications/drfw.desktop"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "contrib/icons/drfw-${size}.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/drfw.png"
    done
    # The unit is generated by the binary itself, so it always loads the file
    # this build's Save to System writes (contrib/drfw.service.in is the template)
    install -dm755 "$pkgdir/usr/lib/systemd/system"
    target/release/drfw print-service-unit > "$pkgdir/usr/lib/systemd/system/drfw.service"
    chmod 644 "$pkgdir/usr/lib/systemd/system/drfw.service"
    # The polkit action for the helper, generated by the binary so its exec
    # path is the helper path this build elevates (template:
    # contrib/org.drfw.helper.policy.in). auth_admin_keep: the password is
    # remembered for ~5 minutes for the DRFW window that asked. No polkit
    # rule (see contrib/README.md)
    install -dm755 "$pkgdir/usr/share/polkit-1/actions"
    target/release/drfw print-polkit-policy > "$pkgdir/usr/share/polkit-1/actions/org.drfw.helper.policy"
    chmod 644 "$pkgdir/usr/share/polkit-1/actions/org.drfw.helper.policy"
}
