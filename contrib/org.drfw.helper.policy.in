<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Generated by "drfw print-polkit-policy" from contrib/org.drfw.helper.policy.in,
  with the helper path this drfw binary was built with (DRFW_HELPER_PATH).
  Regenerate it instead of editing the path by hand.

  drfw-helper is the only program DRFW runs as root. It accepts three fixed
  requests (apply with the revert guard, save the system nftables config,
  check a ruleset), validates every argument against this build's paths and
  refuses everything else. auth_admin_keep: after one password, polkit
  remembers the authorization for about five minutes, for the DRFW process
  that asked only.
-->
<policyconfig>
  <vendor>DRFW</vendor>
  <vendor_url>https://github.com/ledati16/drfw</vendor_url>
  <icon_name>drfw</icon_name>
  <action id="org.drfw.helper">
    <description>Change the firewall rules with DRFW</description>
    <message>Authentication is required to change the firewall rules</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER_PATH@</annotate>
  </action>
</policyconfig>
