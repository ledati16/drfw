[Unit]
Description=DRFW Firewall Service
Documentation=https://github.com/ledati16/drfw
After=network-pre.target
Before=network.target
Wants=network-pre.target
Conflicts=nftables.service

[Service]
Type=oneshot
# Load the rules DRFW's "Save to System" wrote to /etc/nftables.conf (the
# same file nftables.service uses). The file starts with
#   table inet drfw
#   delete table inet drfw
# so loading it replaces only the drfw table, in one transaction: start and
# reload are idempotent and leave other tables (docker, libvirt, ...) alone.
# A file NOT written by DRFW (e.g. a distribution default starting with
# "flush ruleset") would be loaded as-is; check with `drfw status`.
ExecStart=/usr/bin/nft -f /etc/nftables.conf
ExecReload=/usr/bin/nft -f /etc/nftables.conf
# Stop removes only the drfw table. `delete` rather than `destroy`: destroy
# (which ignores a missing table) needs nftables >= 1.0.8, and some supported
# distributions ship older versions. The "-" prefix keeps the unit from
# failing when the table is already gone (e.g. removed by hand).
ExecStop=-/usr/bin/nft delete table inet drfw
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
